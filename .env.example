# ==============================================================================
# LIFECARE AI - ROOT ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Duplicate this file to .env and configure your credentials.
# ==============================================================================

# ----------------- SUPABASE CONFIGURATION (POSTGRESQL & AUTH) -----------------
# Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key (Safe for frontend public client)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (Backend ONLY - Keep strictly confidential)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Connection URL (Used for applying migrations directly)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# ----------------- GOOGLE GENAI CONFIGURATION (VISION & NUTRITION) ------------
# Google Gemini API Key for Food Analysis
GEMINI_API_KEY=your-gemini-api-key

# Gemini Model Identifier (Default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ----------------- SERVER & API CONFIGURATION ---------------------------------
PORT=5000
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# Frontend API base URL (used by Vite client)
VITE_API_URL=http://localhost:5000/api

# ----------------- WEB PUSH NOTIFICATIONS (VAPID) -----------------------------
# Generate using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@lifecare.ai

# ----------------- SCHEDULER CONFIGURATION ------------------------------------
# Check interval for task reminders (cron format, default: every 1 minute)
SCHEDULER_CRON=* * * * *
